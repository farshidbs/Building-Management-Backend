{
  "ConnectionStrings": {
    "BuildingManagement": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "Authority": "",
    "Audience": ""
  },
  "SeedDevelopmentData": false,
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "fileuploads",
    "MaximumImageFileSizeBytes": 10485760,
    "MaximumDocumentFileSizeBytes": 26214400,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedDocumentExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx", ".xls", ".xlsx" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
